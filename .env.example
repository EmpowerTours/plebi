# Postgres connection string. Railway, Supabase, Neon, or a local Postgres all work.
# Railway: this is auto-injected when you attach a Postgres plugin to the project.
DATABASE_URL=postgres://user:password@host:5432/plebi

# Optional: set to "require" when connecting to a managed Postgres (Railway, Supabase, Neon).
PGSSLMODE=disable
